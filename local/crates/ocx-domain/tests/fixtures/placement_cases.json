{
  "version": 1,
  "ticksPerSecond": 120000,
  "description": "ocx-domain placement golden master；时间单位为 ticks。输入轨道字段用 trackType（对应经典版 TS 的 type），输出结果的 trackType 与经典版一致。同一份期望值由 placement_golden_master.rs 与 placement-alignment.test.mjs 共同比对，ID 与 tests/PLACEMENT_CASES.md 一一对应。",
  "cases": [
    { "id": "P01", "category": "正常", "kind": "mapAll", "input": { "elementTypes": ["audio", "text", "sticker", "graphic", "effect", "video", "image"] }, "expected": { "trackTypes": ["audio", "text", "graphic", "graphic", "effect", "video", "video"] } },
    { "id": "P02", "category": "正常", "kind": "compatibility", "input": { "elementType": "video", "trackType": "video" }, "expected": { "result": { "isValid": true } } },
    { "id": "P03", "category": "异常", "kind": "compatibility", "input": { "elementType": "audio", "trackType": "text" }, "expected": { "result": { "isValid": false, "errorMessage": "audio elements cannot be placed on text tracks" } } },
    { "id": "P04", "category": "正常", "kind": "overlap", "input": { "track": { "id": "t", "trackType": "video", "elements": [ { "id": "m1", "startTime": 0, "duration": 120000 } ] }, "timeSpans": [ { "startTime": 240000, "duration": 60000 } ] }, "expected": { "canPlace": true } },
    { "id": "P05", "category": "正常", "kind": "overlap", "input": { "track": { "id": "t", "trackType": "video", "elements": [ { "id": "m1", "startTime": 0, "duration": 120000 } ] }, "timeSpans": [ { "startTime": 60000, "duration": 60000 } ] }, "expected": { "canPlace": false } },
    { "id": "P06", "category": "边界", "kind": "overlap", "input": { "track": { "id": "t", "trackType": "video", "elements": [ { "id": "m1", "startTime": 0, "duration": 120000 } ] }, "timeSpans": [ { "startTime": 0, "duration": 120000, "excludeElementId": "m1" } ] }, "expected": { "canPlace": true } },
    { "id": "P07", "category": "边界", "kind": "overlap", "input": { "track": { "id": "t", "trackType": "video", "elements": [ { "id": "m1", "startTime": 0, "duration": 120000 } ] }, "timeSpans": [] }, "expected": { "canPlace": true } },
    { "id": "P08", "category": "正常", "kind": "earliest", "input": { "mainTrack": { "id": "main", "trackType": "video", "elements": [ { "id": "a", "startTime": 240000, "duration": 60000 }, { "id": "b", "startTime": 120000, "duration": 60000 }, { "id": "c", "startTime": 120000, "duration": 60000 } ] } }, "expected": { "elementId": "b" } },
    { "id": "P09", "category": "边界", "kind": "earliest", "input": { "mainTrack": { "id": "main", "trackType": "video", "elements": [ { "id": "a", "startTime": 240000, "duration": 60000 }, { "id": "b", "startTime": 120000, "duration": 60000 } ] }, "excludeElementId": "b" }, "expected": { "elementId": "a" } },
    { "id": "P10", "category": "边界", "kind": "mainTrack", "input": { "tracks": { "overlay": [ { "id": "o1", "trackType": "graphic", "elements": [] } ], "main": { "id": "main", "trackType": "video", "elements": [ { "id": "m1", "startTime": 0, "duration": 120000 } ] }, "audio": [] }, "targetTrackId": "o1", "requestedStartTime": 240000 }, "expected": { "startTime": 240000 } },
    { "id": "P11", "category": "边界", "kind": "mainTrack", "input": { "tracks": { "overlay": [], "main": { "id": "main", "trackType": "video", "elements": [] }, "audio": [] }, "targetTrackId": "main", "requestedStartTime": 120000 }, "expected": { "startTime": 0 } },
    { "id": "P12", "category": "边界", "kind": "mainTrack", "input": { "tracks": { "overlay": [], "main": { "id": "main", "trackType": "video", "elements": [ { "id": "m1", "startTime": 0, "duration": 120000 } ] }, "audio": [] }, "targetTrackId": "main", "requestedStartTime": 0 }, "expected": { "startTime": 0 } },
    { "id": "P13", "category": "正常", "kind": "mainTrack", "input": { "tracks": { "overlay": [], "main": { "id": "main", "trackType": "video", "elements": [ { "id": "m1", "startTime": 0, "duration": 120000 } ] }, "audio": [] }, "targetTrackId": "main", "requestedStartTime": 240000 }, "expected": { "startTime": 240000 } },
    { "id": "P14", "category": "正常", "kind": "insertIndexAll", "input": { "tracks": { "overlay": [ { "id": "o1", "trackType": "graphic", "elements": [] }, { "id": "o2", "trackType": "text", "elements": [] } ], "main": { "id": "main", "trackType": "video", "elements": [] }, "audio": [ { "id": "a1", "trackType": "audio", "elements": [] } ] } }, "expected": { "default": { "video": 2, "audio": 4, "effect": 0 }, "highest": { "video": 0, "audio": 3, "effect": 0 } } },
    { "id": "P15", "category": "边界", "kind": "preferred", "input": { "tracks": { "overlay": [ { "id": "o1", "trackType": "graphic", "elements": [] }, { "id": "o2", "trackType": "text", "elements": [] } ], "main": { "id": "main", "trackType": "video", "elements": [] }, "audio": [ { "id": "a1", "trackType": "audio", "elements": [] } ] }, "trackType": "video", "preferredIndex": 99, "direction": "below" }, "expected": { "insertIndex": 2, "insertPosition": "above" } },
    { "id": "P16", "category": "正常", "kind": "preferred", "input": { "tracks": { "overlay": [ { "id": "o1", "trackType": "graphic", "elements": [] }, { "id": "o2", "trackType": "text", "elements": [] } ], "main": { "id": "main", "trackType": "video", "elements": [] }, "audio": [ { "id": "a1", "trackType": "audio", "elements": [] } ] }, "trackType": "audio", "preferredIndex": 0, "direction": "below" }, "expected": { "insertIndex": 3, "insertPosition": "below" } },
    { "id": "P17", "category": "异常", "kind": "preferred", "input": { "tracks": { "overlay": [], "main": { "id": "main", "trackType": "video", "elements": [] }, "audio": [] }, "trackType": "video", "preferredIndex": -5, "direction": "above" }, "expected": { "insertIndex": 0, "insertPosition": "above" } },
    { "id": "P18", "category": "正常", "kind": "resolve", "input": { "tracks": { "overlay": [ { "id": "o1", "trackType": "graphic", "elements": [] }, { "id": "o2", "trackType": "text", "elements": [] } ], "main": { "id": "main", "trackType": "video", "elements": [ { "id": "m1", "startTime": 0, "duration": 120000 } ] }, "audio": [ { "id": "a1", "trackType": "audio", "elements": [] } ] }, "subject": { "elementType": "video" }, "timeSpans": [ { "startTime": 240000, "duration": 60000 } ], "strategy": { "type": "explicit", "trackId": "main" } }, "expected": { "result": { "kind": "existingTrack", "trackId": "main", "trackIndex": 2, "trackType": "video" } } },
    { "id": "P19", "category": "异常", "kind": "resolve", "input": { "tracks": { "overlay": [], "main": { "id": "main", "trackType": "video", "elements": [] }, "audio": [] }, "subject": { "elementType": "video" }, "timeSpans": [], "strategy": { "type": "explicit", "trackId": "ghost" } }, "expected": { "result": null } },
    { "id": "P20", "category": "异常", "kind": "resolve", "input": { "tracks": { "overlay": [], "main": { "id": "main", "trackType": "video", "elements": [] }, "audio": [] }, "subject": { "elementType": "audio" }, "timeSpans": [], "strategy": { "type": "explicit", "trackId": "main" } }, "expected": { "result": null } },
    { "id": "P21", "category": "正常", "kind": "resolve", "input": { "tracks": { "overlay": [ { "id": "o1", "trackType": "graphic", "elements": [] }, { "id": "o2", "trackType": "text", "elements": [] } ], "main": { "id": "main", "trackType": "video", "elements": [] }, "audio": [ { "id": "a1", "trackType": "audio", "elements": [] } ] }, "subject": { "elementType": "graphic" }, "timeSpans": [ { "startTime": 0, "duration": 60000 } ], "strategy": { "type": "firstAvailable" } }, "expected": { "result": { "kind": "existingTrack", "trackId": "o1", "trackIndex": 0, "trackType": "graphic" } } },
    { "id": "P22", "category": "边界", "kind": "resolve", "input": { "tracks": { "overlay": [], "main": { "id": "main", "trackType": "video", "elements": [ { "id": "m1", "startTime": 0, "duration": 120000 } ] }, "audio": [] }, "subject": { "trackType": "video" }, "timeSpans": [ { "startTime": 0, "duration": 60000 } ], "strategy": { "type": "firstAvailable" } }, "expected": { "result": { "kind": "newTrack", "insertIndex": 0, "insertPosition": null, "trackType": "video" } } },
    { "id": "P23", "category": "正常", "kind": "resolve", "input": { "tracks": { "overlay": [ { "id": "o1", "trackType": "graphic", "elements": [] }, { "id": "o2", "trackType": "text", "elements": [] } ], "main": { "id": "main", "trackType": "video", "elements": [] }, "audio": [ { "id": "a1", "trackType": "audio", "elements": [] } ] }, "subject": { "elementType": "graphic" }, "timeSpans": [ { "startTime": 0, "duration": 60000 } ], "strategy": { "type": "preferIndex", "trackIndex": 0, "hoverDirection": "below" } }, "expected": { "result": { "kind": "existingTrack", "trackId": "o1", "trackIndex": 0, "trackType": "graphic" } } },
    { "id": "P24", "category": "边界", "kind": "resolve", "input": { "tracks": { "overlay": [ { "id": "o1", "trackType": "graphic", "elements": [] }, { "id": "o2", "trackType": "text", "elements": [] } ], "main": { "id": "main", "trackType": "video", "elements": [] }, "audio": [ { "id": "a1", "trackType": "audio", "elements": [] } ] }, "subject": { "elementType": "graphic" }, "timeSpans": [ { "startTime": 0, "duration": 60000 } ], "strategy": { "type": "preferIndex", "trackIndex": 0, "hoverDirection": "below", "createNewTrackOnly": true } }, "expected": { "result": { "kind": "newTrack", "insertIndex": 1, "insertPosition": "below", "trackType": "graphic" } } },
    { "id": "P25", "category": "正常", "kind": "resolve", "input": { "tracks": { "overlay": [ { "id": "o1", "trackType": "graphic", "elements": [] }, { "id": "o2", "trackType": "text", "elements": [] } ], "main": { "id": "main", "trackType": "video", "elements": [] }, "audio": [ { "id": "a1", "trackType": "audio", "elements": [] } ] }, "subject": { "elementType": "graphic" }, "timeSpans": [ { "startTime": 0, "duration": 60000 } ], "strategy": { "type": "aboveSource", "sourceTrackIndex": 1 } }, "expected": { "result": { "kind": "existingTrack", "trackId": "o1", "trackIndex": 0, "trackType": "graphic" } } },
    { "id": "P26", "category": "边界", "kind": "resolve", "input": { "tracks": { "overlay": [], "main": { "id": "main", "trackType": "video", "elements": [ { "id": "m1", "startTime": 0, "duration": 120000 } ] }, "audio": [ { "id": "a1", "trackType": "audio", "elements": [] } ] }, "subject": { "elementType": "video" }, "timeSpans": [ { "startTime": 0, "duration": 60000 } ], "strategy": { "type": "aboveSource", "sourceTrackIndex": 2 } }, "expected": { "result": { "kind": "newTrack", "insertIndex": 0, "insertPosition": null, "trackType": "video" } } },
    { "id": "P27", "category": "正常", "kind": "resolve", "input": { "tracks": { "overlay": [ { "id": "o1", "trackType": "graphic", "elements": [] }, { "id": "o2", "trackType": "text", "elements": [] } ], "main": { "id": "main", "trackType": "video", "elements": [] }, "audio": [ { "id": "a1", "trackType": "audio", "elements": [] } ] }, "subject": { "trackType": "video" }, "timeSpans": [], "strategy": { "type": "alwaysNew", "position": "default" } }, "expected": { "result": { "kind": "newTrack", "insertIndex": 2, "insertPosition": null, "trackType": "video" } } },
    { "id": "P28", "category": "正常", "kind": "resolve", "input": { "tracks": { "overlay": [ { "id": "o1", "trackType": "graphic", "elements": [] }, { "id": "o2", "trackType": "text", "elements": [] } ], "main": { "id": "main", "trackType": "video", "elements": [] }, "audio": [ { "id": "a1", "trackType": "audio", "elements": [] } ] }, "subject": { "trackType": "audio" }, "timeSpans": [], "strategy": { "type": "alwaysNew", "position": "highest" } }, "expected": { "result": { "kind": "newTrack", "insertIndex": 3, "insertPosition": null, "trackType": "audio" } } },
    { "id": "P29", "category": "异常", "kind": "resolve", "input": { "tracks": { "overlay": [ { "id": "o1", "trackType": "graphic", "elements": [] }, { "id": "o2", "trackType": "text", "elements": [] } ], "main": { "id": "main", "trackType": "video", "elements": [] }, "audio": [ { "id": "a1", "trackType": "audio", "elements": [] } ] }, "subject": { "elementType": "video" }, "timeSpans": [ { "startTime": 0, "duration": 60000 } ], "strategy": { "type": "preferIndex", "trackIndex": 3, "hoverDirection": "below", "verticalDragDirection": "up" } }, "expected": { "result": { "kind": "newTrack", "insertIndex": 2, "insertPosition": "above", "trackType": "video" } } }
  ]
}
