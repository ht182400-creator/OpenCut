{
  "version": 2,
  "description": "Rust Editor API 与 Web 适配层之间的机器可读契约；由 editor-api.contract.test.mjs 校验与 Rust 实现一致。W-11 起接口冻结：字段只增不改，旧版 JSON 缺新增字段时按 v1 兼容。",
  "apiVersion": "0.1.0",
  "schemaVersion": "1",
  "fieldNaming": "camelCase",
  "backendId": "ocx-in-memory",
  "capabilities": ["command", "undo-redo", "snapshot", "discover"],
  "envelope": ["apiVersion", "schemaVersion", "commandId", "kind", "payload"],
  "commands": [
    { "kind": "addClip", "payload": { "label": "string", "durationTicks": "i64" } },
    { "kind": "setPlayhead", "payload": { "ticks": "i64" } },
    { "kind": "clear", "payload": {} }
  ],
  "errors": [
    "UNSUPPORTED_COMMAND",
    "INVALID_PAYLOAD",
    "VERSION_MISMATCH",
    "BACKEND_ALREADY_REGISTERED",
    "HISTORY_EMPTY",
    "STATE_LOCKED"
  ],
  "invariants": ["I-01", "I-03", "I-05"],
  "frozen": true,
  "compatibility": "additive-only",
  "supportedSchemaVersions": ["1"],
  "outcome": ["events", "snapshotId", "schemaVersion"],
  "event": ["kind", "payload", "schemaVersion"],
  "snapshot": ["atTicks", "stateTicks", "clipCount", "label", "snapshotId", "schemaVersion"],
  "discover": ["apiVersion", "schemaVersion", "backendId", "capabilities", "supportedSchemaVersions"],
  "negotiation": {
    "request": ["apiVersion", "schemaVersions", "requiredCapabilities"],
    "result": ["compatible", "schemaVersion", "missingCapabilities", "reason"],
    "reasons": ["OK", "API_VERSION_MISMATCH", "NO_COMMON_SCHEMA", "MISSING_CAPABILITIES"]
  },
  "notes": "W-03 落地 Rust 侧，W-06 接入 TS 适配层，W-11 冻结接口并加入版本化事件/响应/快照与 discover 式能力协商。所有调用必须经 editor-api（I-01），同一时刻只注册一个 core 后端（I-05）。"
}
